---
title: The Beyond Aesthetic Letter
layout: "base.njk"
permalink: "/"
eleventyExcludeFromSitemap: false
---


    <div class="main-box">

        <div class="spacer"></div>

        <h1 class="main-title">THE<br>
            BEYOND<br>
            AESTHETIC<br>
            LETTER</h1>

    <section class="sub-title">
        Ideas for visual creatives building their own path. Writing on perception, creative identity, and the art of intentional living.</section>




    <section class="picture">
        <img src="../assets/start.png" alt="">
    </section>




    <section class="first-email-sub">
        <p class="email-sub-text">Subscribe for weekly insights or explore past letters below.</p>
        <form class="subscribe-form">
            <input 
                type="email" 
                id="email" 
                name="email" 
                placeholder="Enter your email" 
                required 
            />
            <button type="submit">Read For Free</button>
        </form>
        <div id="message"></div>    
    </section>


    {%- for post in collections.post | reverse-%}
    <section class="Blogpost">
        <a href="{{ post.url }}"><h2 class="title" >{{ post.data.title }}</h2></a>
        <p class="info">{{ post.data.author }} · {{ post.data.date | postDate }}</p>
        <hr class="line">
    </section>
    {%- endfor %}


</section>


