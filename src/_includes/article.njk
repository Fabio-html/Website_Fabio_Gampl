---
title: article
layout: "base.njk"
permalink: "/article/{{ title | slug }}/"
eleventyExcludeFromSitemap: false
---
    
    
    <button class="home-button" onclick="window.location.href='/';">All Letters</button>
    
    <div class="main-box">

    <div class="spacer"></div>

    <h1 class="headline-blog">{{ title }}</h1>
    <p class="blog-info">{{ author }} · {{ date | postDate }}</p>

    {{ content | safe }}
    
    <div class="margin"></div>
 
    </div>